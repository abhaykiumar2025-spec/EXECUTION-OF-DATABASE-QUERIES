# ==============================================================================
# SMART PILL DISPENSER - ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5000

# MongoDB Atlas Connection String
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_pill_dispenser?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

